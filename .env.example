# Copy to .env to override. Every value has a default in docker-compose.yml.
# All ports are published on 127.0.0.1 only.

PLATFORM_PORT=4000
WS_MAIN_PORT=8081
EXPRESS_PORT=3000
VITE_PORT=5173
DBADMIN_PORT=8085

# MySQL root password (local use only; the database is not published).
MYSQL_ROOT_PASSWORD=root_pw
